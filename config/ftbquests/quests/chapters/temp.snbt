		}
		{
			dependencies: ["0D1DC5177700C2E7"]
			description: [
				"Netherite has been renamed to Meteorite and generates below y=-32"
				""
				"Vehement coal generates below y=-32"
				""
				"Blackstone and Basalt generates like Tuff"
				""
				"Blaze Powder can be crafted, Blaze Rods in recipes replaced with Gold."
				""
				"Netherite Smithing templates can be traded from Smiths (Tool, armor and weapons) and can be found in their chests."
				""
				"Ruined Portals have Bastion loot."
				""
				"Soul Sand, Netherrack and Glowstone are craftable."
				""
				"Quartz generates in the overworld."
				""
				"Nether Wart and Coffee can be sniffed by Sniffers."
				""
				"Ghast Tears have been renamed to Ashen Rosin and can be obtained by processing Ashen Sap, extracted from Ashen Trees."
			]
			disable_toast: true
			icon: "minecraft:nether_quartz_ore"
			id: "47DE475A19084974"
			optional: true
			size: 1.0d
