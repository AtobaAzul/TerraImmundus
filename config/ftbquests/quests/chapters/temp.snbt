		{
			dependencies: ["178FC7958159A73B"]
			description: ["Terra Immundus removes &4The Nether&r and &5The End&r. Most content of these dimensions are obtainable by either crafting, loot or worldgen."]
			disable_toast: true
			icon: "sob:portal_drink"
